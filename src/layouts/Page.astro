---
import {siteConfig as c} from '../data/siteConfig';
const {page,slug} = Astro.props;
const base=import.meta.env.BASE_URL;
const origin=c.origin+'/';
const resolve=(s)=>s.replaceAll('{{BASE}}',base).replaceAll('{{PHONE_DISPLAY}}',c.phoneDisplay).replaceAll('{{PHONE_HREF}}',c.phoneHref);
const title=slug==='index'?c.brand+' | Hydro Jetting':slug.replaceAll('-',' ')+' | '+c.brand;
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':origin+'#organization',name:c.brand,url:origin,telephone:c.phoneDisplay,areaServed:{'@type':'City',name:'Emporia, Kansas'}},{'@type':'WebPage',name:title,url:origin+(slug==='index'?'':slug+'/'),about:{'@id':origin+'#organization'}}]};
if(!['privacy','terms','contact','service-areas'].includes(slug)) schema['@graph'].push({'@type':'Service',name:title,serviceType:'Hydro jetting information and requests',provider:{'@id':origin+'#organization'},areaServed:{'@type':'City',name:'Emporia, Kansas'}});
---
<!doctype html><html lang="en"><head><Fragment set:html={resolve(page.head)} /><title>{title}</title><meta name="description" content={'Hydro jetting information and service requests for Emporia, Kansas. Inspect drain and sewer lines before choosing high-pressure cleaning.'} /><link rel="canonical" href={origin+(slug==='index'?'':slug+'/')} /><meta name="robots" content={base==='/'?'index,follow':'noindex,follow'} /><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />{c.ga4MeasurementId && <><script is:inline async src={'https://www.googletagmanager.com/gtag/js?id='+c.ga4MeasurementId}></script><script is:inline define:vars={{ga4:c.ga4MeasurementId}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4);</script></>}</head><body><Fragment set:html={resolve(page.body)} /><a style="background:#00d6ec!important;color:#071015!important" class="satellite-call" href={'tel:'+c.phoneHref} aria-label={'Call '+c.brand}>{c.phoneDisplay}</a><script is:inline defer src={base+'assets/lead-form.js'}></script><script is:inline defer data-tracking-id={c.airchattyTrackingId} src="https://api.airchatty.com/js/external-tracking.js"></script><script is:inline defer src={base+'assets/interactions.js'}></script><script is:inline defer src={base+'assets/call-fx.js'}></script><style is:global>.satellite-call{position:fixed;bottom:18px;right:18px;background:#f2690d;color:white;padding:14px 20px;border-radius:7px;font-weight:700;z-index:80;box-shadow:0 4px 16px #0004}.lead-success{padding:30px;text-align:center}.lead-success[hidden]{display:none}.lead-success button{padding:12px;border:1px solid currentColor;margin-top:16px}body{padding-bottom:65px}button{cursor:pointer}.sat-mobile-panel{padding:16px;background:var(--color-primary,#0b1f3a);color:white;display:flex;flex-direction:column;gap:14px}.sat-mobile-panel[hidden]{display:none}.sat-mobile-panel a{color:white}html{scroll-behavior:smooth}</style></body></html>

<style is:global>.new-content-section{max-width:1280px;margin:auto;padding:64px 24px}.new-content-section h1{font-family:var(--font-display,inherit);font-size:clamp(32px,5vw,58px);font-weight:700;line-height:1.05;margin-bottom:25px}.new-content-section h2{font-size:28px;font-weight:700;margin:28px 0 15px}.new-content-section h3{font-size:21px;font-weight:700;margin:22px 0 12px}.new-content-section p,.new-content-section li{line-height:1.75;max-width:900px;margin:14px 0}.new-content-section ul,.new-content-section ol{padding-left:24px}.new-content-section a{color:var(--color-accent,var(--primary,#f2690d))}.new-content-section img{max-width:100%;max-height:480px;object-fit:cover;border-radius:12px}.new-content-section form{max-width:700px;padding:24px;border:1px solid #8885}.new-content-section label{display:block;margin:14px 0}.new-content-section input,.new-content-section textarea{display:block;width:100%;padding:12px;border:1px solid #8888;background:transparent;color:inherit}.new-content-section button{padding:12px 22px;background:#f2690d;color:white}.honeypot{position:absolute!important;width:1px!important;height:1px!important;clip-path:inset(50%)}.sat-desktop-nav{display:flex;gap:20px;align-items:center;font-size:14px;font-weight:600}.sat-desktop-nav details{position:relative}.sat-desktop-nav details div{position:absolute;top:100%;left:0;min-width:240px;padding:16px;background:#0b1f3a;color:white;box-shadow:0 6px 18px #0006;z-index:100;display:flex;flex-direction:column;gap:15px}.sat-desktop-nav summary{cursor:pointer}.sat-mobile-panel details div{display:flex;flex-direction:column;gap:14px;padding:12px}.sat-mobile-panel a{white-space:normal}@media(max-width:1023px){.sat-desktop-nav{display:none}}@media(min-width:1024px){[data-mobile-menu]{display:none}}</style>

<style is:global>form[data-lead-form]{min-width:0;max-width:100%;width:100%;padding:24px;display:flex;flex-direction:column;gap:12px}form[data-lead-form] label{display:flex;flex-direction:column;gap:7px;min-width:0}form[data-lead-form] input,form[data-lead-form] textarea{display:block;min-width:0;width:100%;padding:12px;border:1px solid #8887;border-radius:6px;background:transparent;color:inherit}form[data-lead-form] button[type=submit]{padding:14px;background:#f2690d;color:white;font-weight:700;border-radius:6px}form[data-lead-form] .honeypot{position:absolute!important;clip-path:inset(50%)}header{z-index:90}header a{flex-shrink:0}footer{overflow-wrap:anywhere}</style>

<style is:global>.satellite-call{background:#00d6ec;color:#071015}form[data-lead-form] button[type=submit]{background:#00d6ec;color:#071015}header nav{max-width:1280px;margin:auto;padding:20px 24px}.new-content-section a{color:#00d6ec}</style>

<style is:global>.sat-form{box-sizing:border-box}.sat-form label{margin:0!important}.sat-form input,.sat-form textarea{box-sizing:border-box}.sat-form small{display:block;font-size:12px;line-height:1.6}.sat-form [role=status]{white-space:normal}.sat-form .honeypot{position:absolute!important;left:-9999px!important;display:block!important;width:1px!important;height:1px!important}.sat-form:has(input){color:inherit}header .sat-desktop-nav{padding:0;margin:0}header .sat-desktop-nav>a,header .sat-desktop-nav summary{white-space:nowrap}.dark-mobile-toggle{display:none}.sat-mobile-panel{position:relative}@media(max-width:1023px){.dark-mobile-toggle{display:block}header .sat-desktop-nav{display:none}}.new-content-section form{width:100%}.new-content-section details{padding:15px;border-bottom:1px solid #8885}</style>

<style is:global>header{background:#0a0c10ed!important}header>nav{padding:0 24px!important}header{position:sticky!important}.sat-mobile-panel{background:#0a0c10}.sat-form{background:#10151c;border:1px solid #26323b;color:#e8eef2}.sat-form input,.sat-form textarea{background:#0a0c10}header .sat-desktop-nav details div{background:#10151c}</style>

<style is:global>@media(max-width:1023px){header a{flex-shrink:1;min-width:0}header [data-mobile-menu]{flex-shrink:0}header .font-display{font-size:20px;overflow-wrap:normal}.sat-mobile-panel{width:100%}}.sat-form input[aria-hidden=true]{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important}.sat-form textarea{min-height:110px}.sat-form input:not([aria-hidden=true]){min-height:45px}</style>

<style is:global>@media(max-width:1023px){header .font-display{font-size:18px!important;line-height:1.15!important}header .font-display+span{font-size:9px!important}header>div>div{min-width:0}header .flex.flex-row.items-center.justify-between{gap:8px!important}.sat-desktop-nav{display:none!important}.sat-mobile-panel{position:absolute!important;top:100%;left:0;right:0}}.satellite-call{background:#f2690d!important;color:#fff!important;position:fixed!important;bottom:18px!important;right:18px!important;z-index:80!important}</style>

<style is:global>.satellite-call{background:#00d6ec!important;color:#071015!important}form[data-lead-form] button[type=submit]{background:#00d6ec!important;color:#071015!important}</style>

<style is:global>.inline-content-link{display:inline-block;margin:5px 16px 5px 0;color:#f2690d}.new-content-section{padding-top:40px;padding-bottom:40px}</style>

<style is:global>.sat-sticky-call{background:#00d6ec!important;color:#050c12!important}.inline-content-link{color:#00d6ec!important}</style>

<style is:global>.satellite-call{background:#00d6ec!important;color:#071015!important}</style>
